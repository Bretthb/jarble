# ===========================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy to .env.local and fill in your values
# ===========================================

# Auth0 (handles login UI)
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.jarble.ai

# API URL (jarble-api service)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production: NEXT_PUBLIC_API_URL=https://api.jarble.ai

# App URL (for Auth0 callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://jarble.ai

# Stripe publishable key (for client-side Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# ===========================================
# NOTE: Database, Stripe secret keys, OpenRouter
# are handled by jarble-api (separate repo)
# ===========================================
