# Auth0 ROPC test user credentials
# Copy this file to e2e/.env.test and fill in your test user credentials
#
# Prerequisites (Auth0 Dashboard):
#   1. Applications → Your SPA → Settings → Advanced → Grant Types → enable "Password"
#   2. Settings → Tenant Settings → General → Default Directory → "Username-Password-Authentication"
#   3. User Management → Create User (use Username-Password-Authentication connection)

E2E_TEST_EMAIL=test@jarble.ai
E2E_TEST_PASSWORD=your-test-password-here
