{
  "Comment": "Jarble Bot Deploy",
  "StartAt": "BuildBot",
  "States": {
    "BuildBot": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "jarble-bot-builder",
        "EnvironmentVariablesOverride": [
          {
            "Name": "BOT_ID",
            "Value.$": "$.botId",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "End": true
    }
  }
}
