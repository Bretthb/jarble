# Git
.git
.gitignore

# Dependencies & build outputs (rebuilt in Docker)
**/node_modules
**/dist
**/.next
**/.vercel

# Environment files (passed as build args or runtime env)
**/.env
**/.env.local
**/.env.*.local

# Database files
**/*.db
**/*.db.bak

# IDE
**/.vscode
**/.idea

# Test artifacts
**/coverage
**/test-results
**/playwright-report
**/e2e

# Docs & infrastructure (not needed for frontend build)
docs/
infrastructure/
runtimes/
scripts/
.claude/
.github/
*.md
