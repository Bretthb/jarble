# Copy to secrets.yaml and fill in values - DO NOT COMMIT secrets.yaml!
apiVersion: v1
kind: Secret
metadata:
  name: jarble-api-secrets
  namespace: jarble
type: Opaque
stringData:
  PORT: "3001"
  NODE_ENV: "production"
  FRONTEND_URL: "https://jarble.ai"
  DATABASE_URL: "mysql://user:pass@rds-endpoint:3306/jarble"
  AUTH0_DOMAIN: "your-tenant.auth0.com"
  AUTH0_AUDIENCE: "https://api.jarble.ai"
  OPENROUTER_API_KEY: "sk-or-xxxx"
  STRIPE_SECRET_KEY: "sk_xxxx"
  STRIPE_WEBHOOK_SECRET: "whsec_xxxx"
