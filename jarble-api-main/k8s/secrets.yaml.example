# ═══════════════════════════════════════════════════════════════════════
# Jarble API — Kubernetes Secret Template
# ═══════════════════════════════════════════════════════════════════════
#
# USAGE:
#   cp secrets.yaml.example secrets.yaml
#   # Fill in real values in secrets.yaml
#   kubectl apply -f secrets.yaml
#
# WARNING: Never commit secrets.yaml to version control.
# ═══════════════════════════════════════════════════════════════════════

apiVersion: v1
kind: Secret
metadata:
  name: jarble-api-secrets
  namespace: jarble
type: Opaque
stringData:
  # ── Server ──────────────────────────────────────────────────────────
  PORT: "3001"
  NODE_ENV: "production"
  FRONTEND_URL: "https://jarble.ai"

  # ── Database (REQUIRED) ─────────────────────────────────────────────
  # DB_PROVIDER + USE_SQLITE removed in commit 388018b — Postgres only now
  DATABASE_URL: "postgresql://jarble:CHANGEME@postgres-host:5432/jarble"

  # ── Auth0 (REQUIRED) ────────────────────────────────────────────────
  AUTH0_DOMAIN: "your-tenant.auth0.com"
  AUTH0_AUDIENCE: "https://api.jarble.ai"

  # ── Auth0 M2M — webhook verification (OPTIONAL) ────────────────────
  # AUTH0_M2M_SECRET: ""

  # ── Auth0 Management API — resend verification email (OPTIONAL) ─────
  # AUTH0_MGMT_CLIENT_ID: ""
  # AUTH0_MGMT_CLIENT_SECRET: ""

  # ── OpenRouter (REQUIRED for LLM features) ──────────────────────────
  OPENROUTER_API_KEY: "sk-or-CHANGEME"

  # ── OpenRouter Management — provision tenant keys (OPTIONAL) ────────
  # OPENROUTER_MANAGEMENT_KEY: ""

  # ── Encryption (REQUIRED in production) ─────────────────────────────
  # 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
  API_KEY_ENCRYPTION_KEY: "CHANGEME_64_char_hex_string"

  # ── Stripe (OPTIONAL — disabled if unset) ───────────────────────────
  # STRIPE_SECRET_KEY: "sk_live_CHANGEME"
  # STRIPE_WEBHOOK_SECRET: "whsec_CHANGEME"
  # STRIPE_PRICE_PRO: "price_CHANGEME"
  # STRIPE_PRICE_AGENCY: "price_CHANGEME"
