# ===========================================
# API ENVIRONMENT VARIABLES
# Copy to .env and fill in your values
# ===========================================

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ===========================================
# Database
# ===========================================

# For testing: in-memory SQLite (auto-seeds with test data)
USE_SQLITE=true

# For production: MySQL/RDS (comment out USE_SQLITE)
# DATABASE_URL=mysql://user:password@your-rds-endpoint:3306/jarble

# Auth0 (same tenant as frontend)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.jarble.ai

# Auth0 M2M — shared secret for Auth0 Action webhooks (email verification sync)
# Generate with: openssl rand -hex 32
AUTH0_M2M_SECRET=your-m2m-secret-here

# OpenRouter (LLM API)
OPENROUTER_API_KEY=sk-or-v1-xxxx

# OpenRouter Management API key — required for "Included Credits" provisioning
# Create a management key at: https://openrouter.ai/settings/keys
# This master key provisions per-deployment tenant keys with spending limits
# OPENROUTER_MANAGEMENT_KEY=sk-or-v1-xxxx

# API key encryption — encrypts LLM API keys at rest in the database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in dev (keys stored as plaintext), required in production
# API_KEY_ENCRYPTION_KEY=your-64-char-hex-string

# Stripe (billing - optional for initial testing)
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Resend (email — optional, beta invite emails)
# RESEND_API_KEY=re_xxxx
