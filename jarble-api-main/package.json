{
  "name": "jarble-api",
  "version": "1.0.0",
  "description": "Jarble API - Express + tRPC backend",
  "main": "dist/index.js",
  "types": "src/trpc/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "USE_SQLITE=true tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "db:push": "drizzle-kit push:mysql",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate:mysql"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.20.0",
    "@trpc/server": "^11.6.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.29.0",
    "express": "^4.18.2",
    "jose": "^5.2.0",
    "mysql2": "^3.9.0",
    "nanoid": "^5.0.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "superjson": "^2.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
