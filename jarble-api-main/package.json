{
  "name": "jarble-api",
  "version": "1.0.0",
  "description": "Jarble API - Express + tRPC backend",
  "main": "dist/index.js",
  "types": "dist/trpc/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "USE_SQLITE=true tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.config.pg.ts",
    "db:push:pg": "drizzle-kit push --config=drizzle.config.pg.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.20.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@trpc/server": "^11.10.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "jose": "^5.2.0",
    "mysql2": "^3.9.0",
    "nanoid": "^5.0.0",
    "pg": "^8.18.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "stripe": "^20.3.1",
    "superjson": "^2.2.1",
    "ws": "^8.19.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
