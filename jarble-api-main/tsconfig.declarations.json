{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "noEmit": false,
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "../shared/**/*"
  ],
  "exclude": [
    "**/*.test.*",
    "**/__tests__/**",
    "node_modules",
    "dist"
  ]
}
