# Dependencies
**/node_modules/
.pnpm-store/

# Environment variables (NEVER commit these)
.env
.env.local
.mcp.json
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
.next/
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/

# Screenshots & test snapshots (local debugging only)
*.png
*.jpg
*.jpeg
*.gif
qa-screenshots/
# Playwright accessibility-tree dumps used by QA agents
*-snapshot.md

# Allow logo/favicon assets
!Jarble-mvp/public/logo.png
!Jarble-mvp/public/logodark.png
!Jarble-mvp/public/favicon.png
tmp_db.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

