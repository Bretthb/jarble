# Nightly QA reports (screenshots + HTML, regenerated each run)
scripts/nightly-qa/reports/

# CodeGraphContext — graph DB is regenerated via `cgc index .`
.codegraphcontext/
*.cgc-bundle

# Playwright MCP logs
.playwright-mcp/

# Disposable git worktrees used by nightly per-branch QA
.worktrees/

# Runtime build artifacts — copied fresh from jarble-api-main/src/mcp/ at
# CI build time (see .github/workflows/deploy-runtimes.yml). Do not commit:
# the canonical source lives under jarble-api-main/.
runtimes/openclaw/jarble-ui-server.js

# Claude Code — ignore session data, keep agents, settings, and memory
.claude/*
!.claude/agents/
!.claude/memory/
!.claude/agent-memory/
!.claude/rules/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
!.claude/settings.local.json
!.claude/commands/
!.claude/crew.json
scripts/nightly-qa/.env
scripts/nightly-qa/.qa-state.json
scripts/nightly-qa/.qa-lock
scripts/nightly-qa/logs/
