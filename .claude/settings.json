{
  "mcpServers": {
    "codegraphcontext": {
      "command": "bash",
      "args": [
        "scripts/cgc-mcp.sh"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "jarble-debug": {
      "command": "bash",
      "args": [
        "scripts/jarble-debug-mcp.sh"
      ],
      "env": {
        "JARBLE_API_URL": "http://localhost:3001"
      }
    },
    "playwright": {
      "command": "C:\\nvm4w\\nodejs\\node.exe",
      "args": [
        "C:\\nvm4w\\nodejs\\node_modules\\npm\\bin\\npx-cli.js",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "C:\\nvm4w\\nodejs\\node.exe",
      "args": [
        "C:\\nvm4w\\nodejs\\node_modules\\npm\\bin\\npx-cli.js",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "auth0": {
      "command": "node",
      "args": [
        "C:\\Program Files\\nodejs\\node_modules\\npm\\bin\\npx-cli.js",
        "-y",
        "@auth0/auth0-mcp-server",
        "run",
        "--tools",
        "*"
      ],
      "env": {
        "DEBUG": "auth0-mcp"
      }
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp"
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "TFE_TOKEN",
        "hashicorp/terraform-mcp-server:latest"
      ]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          "bash scripts/claude-hooks/session-start.sh",
          "node .claude/hooks/ticket-context-start.mjs"
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          "bash scripts/claude-hooks/session-end.sh",
          "node .claude/hooks/ticket-session-end.mjs"
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          "node .claude/hooks/block-lockfiles.js"
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          "node .claude/hooks/typecheck-pre-commit.js"
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          "node .claude/hooks/format.js"
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          "node .claude/hooks/ticket-track-changes.mjs"
        ],
        "matcher": "Edit|Write|Bash"
      }
    ]
  }
}
