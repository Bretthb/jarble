{
  "mcpServers": {
    "codegraphcontext": {
      "command": "bash",
      "args": ["scripts/cgc-mcp.sh"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "jarble-debug": {
      "command": "bash",
      "args": ["scripts/jarble-debug-mcp.sh"],
      "env": {
        "JARBLE_API_URL": "http://localhost:3001"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          "bash scripts/claude-hooks/session-start.sh"
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          "bash scripts/claude-hooks/session-end.sh"
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          "node .claude/hooks/block-lockfiles.js"
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          "node .claude/hooks/format.js"
        ],
        "matcher": "Edit|Write"
      }
    ]
  }
}
