# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git

hcloud_token         = "your-hetzner-api-token"
ssh_public_key_path  = "~/.ssh/id_rsa.pub"
ssh_private_key_path = "~/.ssh/id_rsa"
# ssh_public_key     = "ssh-rsa AAAA..."   # CI uses this via TF_VAR_ssh_public_key

# Cluster settings
cluster_name       = "jarble"
location           = "ash"          # ash (US East), fsn1 (Germany), nbg1 (Germany), hel1 (Finland)
network_zone       = "us-east"      # us-east, eu-central

# Server types — see https://www.hetzner.com/cloud#pricing
master_server_type = "cpx21"        # 3 vCPU, 4GB RAM — $7.59/mo
agent_server_type  = "cpx21"        # 3 vCPU, 4GB RAM — $7.59/mo
agent_count        = 2              # Number of worker nodes

# Block Storage (Longhorn persistent volumes)
# longhorn_volume_size = 100       # GB per worker node (default: 100, increase for more deployments)

# K3s
k3s_version = "v1.29.2+k3s1"
# k3s_token = ""                   # Leave empty to auto-generate

# DNS
domain = "jarble.ai"

# Sandbox Isolation (Track B)
# enable_gvisor           = true    # Create gVisor RuntimeClass (install runsc on workers first)
# enable_kata             = true    # Create Kata+CLH RuntimeClass (requires dedicated server)
# enable_dedicated_server = true    # Generate setup script for Hetzner dedicated server
# dedicated_server_type   = "AX42"  # For documentation — server provisioned via Robot
